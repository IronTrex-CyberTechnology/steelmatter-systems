{
  "name": "@irontrex/steelmatter-verifier",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone verifier for Steelmatter SM-JWS-ES256-1 evidence. No engine, database or model API required.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.11.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "jose": "6.2.12"
  },
  "bin": {
    "steelmatter-verify": "./dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
