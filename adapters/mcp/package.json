{
  "name": "@irontrex/steelmatter-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Thin MCP (Model Context Protocol) adapter exposing the Steelmatter R0 actor operations to an agent over stdio, through @irontrex/steelmatter-sdk.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.11.0"
  },
  "bin": {
    "steelmatter-mcp": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@irontrex/steelmatter-sdk": "file:../../packages/sdk"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
