#!/usr/bin/env bash
# One-command CLI demonstration from a clean state (I08, T31):
# fresh synthetic keys, a fresh database, the service, all demo scenarios,
# offline verification of the flagship evidence, then teardown.
#
#   STEELMATTER_ADMIN_URL=postgres://user@localhost:5432/postgres?sslmode=disable scripts/demo
#
# Needs Go, a local PostgreSQL (or scripts/dev-postgres) and, for the evidence
# check, Node with packages/verifier dependencies installed. No production
# service, credential or model API is used. DEMO_KEEP=1 keeps the database
# and service logs for inspection.
source "$(dirname "$0")/lib.sh"
require_go
[[ -n "${STEELMATTER_ADMIN_URL:-}" ]] || die "STEELMATTER_ADMIN_URL is not set (cluster admin with CREATEDB/CREATEROLE; see scripts/dev-postgres)"
command -v curl >/dev/null || die "curl is required"
started=$(date +%s)

RUN="demo_$(date +%Y%m%d_%H%M%S)_$$"
DIR="$ROOT/.local/$RUN"
mkdir -p "$DIR/bin" "$DIR/out"; chmod 700 "$ROOT/.local" "$DIR"
log "run $RUN in .local/$RUN"

log "building binaries (release build: no failpoints)"
for c in steelmatter smkeys smdemo; do go build -trimpath -o "$DIR/bin/$c" "./cmd/$c"; done

log "generating synthetic signing keys"
"$DIR/bin/smkeys" generate -dir "$DIR/keys" -name steelmatter-service -purpose SM-PERMIT+JWS -purpose SM-EXECUTION+JWS >/dev/null
"$DIR/bin/smkeys" generate -dir "$DIR/keys" -name synthetic-owner -purpose SM-MANDATE+JWS >/dev/null
"$DIR/bin/smkeys" generate -dir "$DIR/keys" -name steelmatter-observer -purpose SM-OBSERVATION+JWS >/dev/null

DB="steelmatter_${RUN}"
log "creating fresh database $DB"
"$DIR/bin/steelmatter" db-init -name "$DB" -env-out "$DIR/db.env" >/dev/null
# shellcheck source=/dev/null
source "$DIR/db.env"

PORT="${DEMO_PORT:-$((20000 + RANDOM % 10000))}"
URL="http://127.0.0.1:$PORT"
curl -s -o /dev/null "$URL/v1/health" && die "port $PORT is already in use; set DEMO_PORT"
log "starting service on $URL"
STEELMATTER_DATABASE_URL="$STEELMATTER_DATABASE_URL" STEELMATTER_OBSERVER_URL="$STEELMATTER_OBSERVER_URL" \
STEELMATTER_KEYS_DIR="$DIR/keys" STEELMATTER_HTTP_ADDR="127.0.0.1:$PORT" STEELMATTER_WORKER_INTERVAL_MS=200 \
  "$DIR/bin/steelmatter" serve >"$DIR/service.log" 2>&1 &
SERVER_PID=$!

cleanup() {
  kill "$SERVER_PID" 2>/dev/null || true
  wait "$SERVER_PID" 2>/dev/null || true
  if [[ "${DEMO_KEEP:-0}" == "1" ]]; then
    log "kept database $DB and logs in .local/$RUN"
  else
    "$DIR/bin/steelmatter" db-drop -name "$DB" || warn "could not drop $DB"
    rm -rf "$DIR/db.env" "$DIR/demo-tokens.json"
  fi
}
trap cleanup EXIT

for _ in $(seq 1 100); do
  curl -sf -o /dev/null "$URL/v1/ready" && break
  kill -0 "$SERVER_PID" 2>/dev/null || { cat "$DIR/service.log"; die "service exited during startup"; }
  sleep 0.1
done
curl -sf -o /dev/null "$URL/v1/ready" || die "service not ready"

"$DIR/bin/smdemo" setup -admin-url "$STEELMATTER_DB_ADMIN_URL" -tokens "$DIR/demo-tokens.json"
# The commit recorded in the run's trace (T43), marked -dirty when tracked
# files have uncommitted changes, as demo/build.mjs marks the page build.
COMMIT="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
if [[ "$COMMIT" != unknown && -n "$(git -C "$ROOT" status --porcelain --untracked-files=no 2>/dev/null)" ]]; then
  COMMIT="$COMMIT-dirty"
fi
status=0
"$DIR/bin/smdemo" run -server "$URL" -admin-url "$STEELMATTER_DB_ADMIN_URL" -tokens "$DIR/demo-tokens.json" \
  -scenario "${DEMO_SCENARIO:-all}" -out "$DIR/out" -json "$OUT/demo.json" \
  -commit "$COMMIT" -reference "$ROOT/fixtures/demo/reference-results-v1.json" || status=$?

if [[ -f "$DIR/out/flagship-evidence.json" ]]; then
  if command -v node >/dev/null && [[ -d "$ROOT/packages/verifier/node_modules" ]]; then
    echo
    log "verifying the flagship evidence offline with the standalone verifier"
    node "$ROOT/packages/verifier/src/cli.ts" verify --trust "$DIR/keys/trust-store.json" --bundle "$DIR/out/flagship-evidence.json" \
      --fail-on integrity,issuer,profile,linkage,chronology,observation || status=1
  else
    log "skipping offline evidence verification (needs node and packages/verifier/node_modules; run scripts/test-verifier once)"
  fi
fi

echo
log "demo finished in $(( $(date +%s) - started ))s with status $status (results: .out/demo.json)"
exit "$status"
