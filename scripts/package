#!/usr/bin/env bash
# Build release binaries for the current platform with checksums.
source "$(dirname "$0")/lib.sh"
require_go
commit="$(source_commit)"
[[ "$commit" == unknown ]] || commit="${commit:0:12}${commit:40}" # short SHA, keeping any -dirty
dest="$ROOT/dist/$(go env GOOS)-$(go env GOARCH)"
rm -rf "$dest"; mkdir -p "$dest"
for cmd in steelmatter smkeys; do
  CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=$commit" -o "$dest/$cmd" "./cmd/$cmd"
done
(cd "$dest" && shasum -a 256 steelmatter smkeys > SHA256SUMS)
log "built $commit into $dest"
cat "$dest/SHA256SUMS"
