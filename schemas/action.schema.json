{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:steelmatter:proposed:action:1",
  "title": "action proposed unsigned payload",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "crypto_profile": {
      "const": "SM-JWS-ES256-1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "instruction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "action_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "operation": {
      "const": "purchase_order.issue"
    },
    "supplier_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "supplier_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "delivery_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "currency": {
      "const": "INR"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "unit_price_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "item_id",
          "quantity",
          "unit_price_minor"
        ],
        "additionalProperties": false
      }
    },
    "amount_minor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema_version",
    "crypto_profile",
    "tenant_id",
    "instruction_id",
    "action_revision",
    "actor_id",
    "audience",
    "operation",
    "supplier_id",
    "supplier_revision",
    "delivery_id",
    "currency",
    "lines",
    "amount_minor"
  ],
  "additionalProperties": false
}
